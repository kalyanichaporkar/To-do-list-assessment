{
    "info": {
        "name": "To-Do List API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "_postman_id": "todo-api-collection-id"
    },
    "item": [
        {
            "name": "Get All Tasks",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://localhost:8080/api/tasks",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "tasks"
                    ]
                }
            }
        },
        {
            "name": "Create Task",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"title\": \"Sample Task\",\n    \"description\": \"This is a task description\",\n    \"isCompleted\": false\n}"
                },
                "url": {
                    "raw": "http://localhost:8080/api/task",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "task"
                    ]
                }
            }
        },
        {
            "name": "Update Task",
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"title\": \"Updated Task\",\n    \"description\": \"Updated description\",\n    \"isCompleted\": true\n}"
                },
                "url": {
                    "raw": "http://localhost:8080/api/task/:id",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "task",
                        ":id"
                    ]
                }
            }
        },
        {
            "name": "Delete Task",
            "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                    "raw": "http://localhost:8080/api/task/:id",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "task",
                        ":id"
                    ]
                }
            }
        }
    ]
}